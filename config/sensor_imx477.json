{
  "_comment": "センサー依存設定 (IMX477)。型番で決まる値だけ。RAW形式(wire_format/bits/stride)・rpicam_cmdはPiの世代、WBはカメラ個体で変わるため観測プラン(meteor_imx477_pi4/pi5.json)に書く(README「設定ファイル」参照)",
  "width": 2028,
  "height": 1520,
  "raw_width": 2028,
  "raw_height": 1520,
  "crop_x": 0,
  "crop_y": 0,
  "u12_shift": "auto",
  "u10_shift": "auto",
  "bayer": "RGGB",
  "skip": 0,
  "timeout": 120,
  "no_stretch": false,
  "max_frames": 300,
  "ser_lsb": false,
  "rec_dir": "recordings",
  "no_rec_raw": false,
  "no_rec_stack": false,
  "no_rec_folder": false,
  "flip_h": false,
  "flip_v": false,
  "dark_file": "dark.fits",
  "roi": null,
  "stop_threshold": null,
  "stop_ratio": 10.0,
  "gamma": 0.8,
  "zoom_pip_size": 640,
  "zoom_click_size": 128,
  "zoom_corner": "br",
  "rpicam_vid_cmd": "rpicam-vid -t 0 -n --width 2028 --height 1520 --framerate 15 --codec h264 --listen -o tcp://0.0.0.0:8889 --bitrate 8000000",
  "no_ssh": false
}
