{
  "_comment": "センサー依存設定 (IMX477, Pi 5)。Pi 5はrpicam-rawが既定でPISP圧縮(BGGR_PISP_COMP1)を出し受信側で読めないため、動作実績(Pi 5 + IMX708)と同じ非圧縮 12:U を指定。Bayerはrpicam-rawログはBGGRと表示だが実際はRGGB(画面でR/B逆を確認)。Pi 5は行を64バイト単位に揃えるためstrideは4096(補完値の4064では斜めにずれる)",
  "width": 2028,
  "height": 1520,
  "raw_width": 2028,
  "raw_height": 1520,
  "crop_x": 0,
  "crop_y": 0,
  "stride": 4096,
  "wire_format": "12u",
  "u12_shift": "auto",
  "u10_shift": "auto",
  "bits": 16,
  "bayer": "RGGB",
  "skip": 0,
  "timeout": 120,
  "no_stretch": false,
  "max_frames": 300,
  "ser_lsb": false,
  "rec_dir": "recordings",
  "no_rec_raw": false,
  "no_rec_stack": false,
  "no_rec_folder": false,
  "flip_h": false,
  "flip_v": false,
  "dark_file": "dark.fits",
  "roi": null,
  "stop_threshold": null,
  "stop_ratio": 10.0,
  "wb_b": 1.35,
  "wb_g": 1.0,
  "wb_r": 2.45,
  "gamma": 0.8,
  "zoom_pip_size": 640,
  "zoom_click_size": 128,
  "zoom_corner": "br",
  "rpicam_cmd": "rpicam-raw --mode 2028:1520:12:U --width 2028 --height 1520 --framerate 5 -t 0 --listen -o tcp://0.0.0.0:8888 --shutter 200000 --gain 8",
  "rpicam_vid_cmd": "rpicam-vid -t 0 -n --width 2028 --height 1520 --framerate 15 --codec h264 --listen -o tcp://0.0.0.0:8889 --bitrate 8000000",
  "no_ssh": false
}
