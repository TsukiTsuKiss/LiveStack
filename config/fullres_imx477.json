{
  "_comment": "観測プラン: 全周撮影 (魚眼) (Pi 5 + IMX477, 本来の解像度4056x3040)。meteor_imx477.json(ビニング2028x1520)に対し解像度と送信コマンドのみ上書き。stride 8128はrpicam-rawログで確認",
  "host": "host_raspi_5.json",
  "sensor": "sensor_imx477.json",
  "meta": "meta_imx477.json",
  "object": "meteor",
  "width": 4056,
  "height": 3040,
  "raw_width": 4056,
  "raw_height": 3040,
  "stride": 8128,
  "max_frames": 30,
  "rpicam_cmd": "rpicam-raw --mode 4056:3040:12:U --width 4056 --height 3040 --framerate 1 -t 0 --listen -o tcp://0.0.0.0:8888 --shutter 500000 --gain 8"
}
