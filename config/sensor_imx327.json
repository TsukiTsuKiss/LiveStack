{
  "_comment": "センサー依存設定 (IMX327。IMX290上位互換でIMX462も共通)。Pi側は /boot/firmware/config.txt に camera_auto_detect=0 と dtoverlay=imx290 が必要。rpicam-rawログはSRGGB12_CSI2P(stride 2880)だが実際の色配列はBGGR。WBは白壁で取った値。露出は未調整の仮値",
  "width": 1920,
  "height": 1080,
  "raw_width": 1920,
  "raw_height": 1080,
  "crop_x": 0,
  "crop_y": 0,
  "stride": null,
  "wire_format": "12p",
  "u12_shift": "auto",
  "u10_shift": "auto",
  "bits": 12,
  "bayer": "BGGR",
  "skip": 0,
  "timeout": 120,
  "no_stretch": false,
  "max_frames": 300,
  "ser_lsb": false,
  "rec_dir": "recordings",
  "no_rec_raw": false,
  "no_rec_stack": false,
  "no_rec_folder": false,
  "flip_h": false,
  "flip_v": false,
  "dark_file": "dark.fits",
  "roi": null,
  "stop_threshold": null,
  "stop_ratio": 10.0,
  "wb_b": 2.28,
  "wb_g": 1.0,
  "wb_r": 1.52,
  "gamma": 0.8,
  "zoom_pip_size": 640,
  "zoom_click_size": 128,
  "zoom_corner": "br",
  "rpicam_cmd": "rpicam-raw --width 1920 --height 1080 --framerate 5 -t 0 --listen -o tcp://0.0.0.0:8888 --shutter 20000 --gain 10",
  "rpicam_vid_cmd": "rpicam-vid -t 0 -n --width 1920 --height 1080 --framerate 15 --codec h264 --listen -o tcp://0.0.0.0:8889 --bitrate 8000000",
  "no_ssh": false
}
